ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace-before-first-seed
LOYALTY_POINTS_PER_RUPEE=0.1
LOYALTY_RUPEES_PER_POINT=0.1
LOYALTY_MAX_REDEMPTION_PERCENT=30
REFERRER_REWARD_POINTS=100
REFERRED_CUSTOMER_REWARD_POINTS=50
