# Shared hosting (Hostinger): the project root is the web root. Serve every
# request from public/ without showing it in the URL, so /about is handled by
# public/index.php. Nothing outside public/ — storage/logs, vendor/, .env,
# composer files, deploy scripts — can be reached, because every path is
# looked up inside public/ instead.
#
# Requests that already start with /public/ are handled by public/.htaccess,
# which redirects them to the clean URL.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Leave certificate validation files where the host puts them.
    RewriteRule ^\.well-known/ - [L]

    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
